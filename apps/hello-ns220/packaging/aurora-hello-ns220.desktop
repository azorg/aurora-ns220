[Desktop Entry]
Type=Application
Name=Hello NS220
Name[ru]=Hello NS220
Comment=Go + Fyne + OpenGL demo for Aurora OS (NS220)
Comment[ru]=Демонстрация Go + Fyne + OpenGL на Aurora OS (NS220)
Exec=/usr/bin/aurora-hello-ns220-launch
Icon=aurora-hello-ns220
Terminal=false
Categories=Development;Utility;

# Aurora запускает приложение в песочнице sailjail по «Default Profile»
# (Audio;Bluetooth;Camera;…;WebView) — отсюда вопрос о разрешениях при первом
# запуске и падение: в песочнице недоступен /run/display/wayland-0 и /dev/mali0.
# Отключаем песочницу, как это делают системные fingerterm/csd. См. bugs B029.
[X-Sailjail]
Sandboxing=Disabled
