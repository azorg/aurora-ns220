#!/bin/bash
# usage: runroot script.sh  -> copies to device /tmp and runs as root
f="$1"
sshpass -p 1234 scp -q -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null "$f" user@192.168.2.15:/tmp/__s.sh || exit 1
sshpass -p 1234 ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null user@192.168.2.15 "chmod +x /tmp/__s.sh; echo 1234 | devel-su sh /tmp/__s.sh" 2>&1 | grep -v -e '^Password: ' -e '^Warning: Permanently'
