+                                          uint32_t edges,
+                                          int32_t width,
+                                          int32_t height)
+{
+    _GLFWwindow* window = (_GLFWwindow*) userData;
+
+    if (width > 0 && height > 0)
+    {
+        window->wl.width = width;
+        window->wl.height = height;
