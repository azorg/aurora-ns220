# Крупные блобы и результаты сборки в git НЕ храним (см. AGENTS.md,
# раздел «Крупные файлы: репозиторий vs хранилище»). Внешнее хранилище:
#   ~/aurora-ns220/{bootdump,fw,meta,parts}
# В репозитории — только исходники/документация/скрипты/патчи и ссылки
# на файлы хранилища с контрольными суммами.

# образы и прошивки
*.img
*.bin.bak
*.elf
*.zip
*.tgz
*.tar.gz
*.tar.xz
*.7z
*.deb
*.rpm

# результаты сборки приложений
apps/*/hello-ns220
apps/*/*.armv7
apps/*/hello-shot*.png
build/
dist/
*.log
